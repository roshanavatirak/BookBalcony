// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                     String      @id @default(uuid())
  mongoId                String?     @unique // Preserves legacy Mongo ObjectId if migrated
  userId                 String // MongoDB User ObjectId
  bookId                 String? // Direct book reference (for single book orders)
  sellerId               String // MongoDB Seller User ObjectId
  paymentMethod          String // COD or RAZORPAY
  paymentStatus          String      @default("Pending") // Pending, Success, Failed
  orderStatus            String      @default("Order Placed") // Order Placed, Processing, Shipped, Out for Delivery, Delivered, Cancelled
  amountPayable          Float
  discount               Float       @default(0)
  handlingFee            Float       @default(0)
  shippingAddress        Json
  currentLocation        String      @default("Warehouse")
  expectedDeliveryDate   DateTime?
  actualDeliveryDate     DateTime?
  sellerNotified         Boolean     @default(false)
  sellerNotificationRead Boolean     @default(false)
  sellerNotificationDate DateTime?
  trackingHistory        Json? // Array of { status, location, date }
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySignature      String?
  items                  OrderItem[]
  payment                Payment?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([sellerId, createdAt])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String // MongoDB Book ObjectId
  title     String? // Book title snapshot
  price     Float? // Price snapshot
  quantity  Int      @default(1)
  status    String   @default("Order Placed") // Order Placed, Cancelled, Shipped, Delivered
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}

model Payment {
  id                  String   @id @default(uuid())
  mongoId             String?  @unique // Preserves legacy Mongo ObjectId if migrated
  userId              String // MongoDB User ObjectId
  orderId             String?  @unique
  order               Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount              Float
  currency            String   @default("INR")
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  receipt             String?
  status              String   @default("Pending")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("payments")
}
